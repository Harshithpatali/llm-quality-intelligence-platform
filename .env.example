GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731

JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b
RUBRIC_PROVIDER=groq
RUBRIC_MODEL=qwen/qwen3.8-27b

# Optional model pricing snapshot for estimated evaluation cost.
MODEL_PRICING_USD_PER_MILLION={"groq/openai/gpt-oss-120b":{"input":0.15,"output":0.60},"groq/openai/gpt-oss-20b":{"input":0.075,"output":0.30},"openrouter/deepseek/deepseek-v4-flash-0731":{"input":0.018,"output":0.32},"groq/qwen/qwen3.8-27b":{"input":0.80,"output":4.00}}

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Backend only. Prefer the Supabase secret key; never expose it to Streamlit or commit it.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional demo API protection. If set here, also set the same value in Streamlit secrets.
API_ACCESS_TOKEN=
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300

ALLOWED_ORIGINS=*

# Frontend only
API_URL=http://localhost:8000
